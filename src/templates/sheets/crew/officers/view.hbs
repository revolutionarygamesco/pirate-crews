<section class="tab scrollable {{tab.cssClass}}" data-tab="officers" data-group="primary" data-mode="view">
  {{#each officers as |officer|}}
    <section class="officer {{officer.key}}" data-officer-key="{{officer.key}}">
      <h4>
        {{officer.title}}
        {{#if officer.actor}}
          {{{officer.actor}}}
        {{/if}}
      </h4>
      {{#if ../editable}}
      <label class="shares">
        <span>{{localize "revolutionary-piratecrews.sheet.officers.shares"}}</span>
        {{formInput officer.shares.field value=officer.shares.value name=officer.shares.name}}
      </label>
      {{/if}}
      <p>{{officer.desc}}</p>
      {{#unless officer.actor}}
        <p class="null">
          {{{officer.sans}}}
        </p>
      {{/unless}}
      {{#if officer.unassignable}}
        <button type="button" class="unassign" data-action="unassignOfficer">
          <i class="fa-solid fa-user-slash"></i>
          {{localize 'revolutionary-piratecrews.sheet.officers.unassign'}}
        </button>
      {{/if}}
    </section>
  {{/each}}
</section>
