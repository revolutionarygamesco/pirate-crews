<header class="crew-header">
  <img src="{{actor.img}}" data-edit="img" alt="{{actor.name}}" />
  {{#if editing}}
    <input type="text" name="name" value="{{actor.name}}" placeholder="Crew" />
  {{else}}
    <h1>{{actor.name}}</h1>
  {{/if}}
  {{#if editable}}
    <button type="button" class="edit-toggle" data-action="toggleEdit" data-tooltip="{{localize 'revolutionary-piratecrews.sheet.header.toggleEdit'}}">
      <i class="fa-solid {{#if editing}}fa-lock-open{{else}}fa-lock{{/if}}"></i>
    </button>
  {{/if}}
  <div class="related">
    <div class="articles{{#unless articles}} null{{/unless}}">
      {{#if articles}}
        {{{articles}}}
      {{else}}
        {{localize 'revolutionary-piratecrews.sheet.header.drop.articles'}}
      {{/if}}
    </div>
    <div class="ship{{#unless ship}} null{{/unless}}">
      {{#if ship}}
        {{{ship}}}
      {{else}}
        {{localize 'revolutionary-piratecrews.sheet.header.drop.ship'}}
      {{/if}}
    </div>
  </div>
</header>